# Copiez ce fichier en « .env » et renseignez les valeurs.
# Aucune de ces variables n'est secrète : elles sont exposées au navigateur (préfixe PUBLIC_).

# URL de production du site (sert au sitemap, aux liens canoniques et Open Graph).
SITE_URL="https://padelapp.fr"

# Endpoint du formulaire de démo et de la capture d'e-mail joueur.
# Exemple avec Formspree : créez un formulaire sur https://formspree.io puis collez son URL ici.
# Tant que cette variable est vide, les formulaires affichent un message d'aide au lieu d'envoyer.
PUBLIC_FORM_ENDPOINT=""
