---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/Button.astro';
import Bracket from '../components/Bracket.astro';
import TrajectoryArc from '../components/TrajectoryArc.astro';

const { meta, hero, constat, publics, deroule, complementarite, preuve, ctaFinal } = (
  await getEntry('pages', 'accueil')
)!.data as any;

const site = (await getEntry('global', 'site'))!.data;
---

<Base titre={meta.titre} description={meta.description} ogImage={meta.ogImage} structuredData={true}>
  <!-- ============ HERO — la thèse : un tableau en direct ============ -->
  <section class="relative overflow-hidden bg-blanc">
    <!-- Trame discrète de lignes de piste, en fond, une seule fois -->
    <div class="pointer-events-none absolute inset-0 opacity-[0.04]" aria-hidden="true">
      <svg width="100%" height="100%" preserveAspectRatio="xMidYMid slice" viewBox="0 0 1200 700">
        <rect x="120" y="60" width="960" height="580" fill="none" stroke="#061B3A" stroke-width="2" />
        <line x1="600" y1="60" x2="600" y2="640" stroke="#061B3A" stroke-width="2" />
        <line x1="120" y1="230" x2="1080" y2="230" stroke="#061B3A" stroke-width="2" />
        <line x1="120" y1="470" x2="1080" y2="470" stroke="#061B3A" stroke-width="2" />
      </svg>
    </div>

    <div class="container-x relative grid items-center gap-10 py-16 md:py-24 lg:grid-cols-[1.05fr_0.95fr]">
      <div>
        <h1 class="text-3xl font-bold leading-tight text-marine md:text-4xl">{hero.titre}</h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-gris-600 md:text-lg">
          {hero.sousTitre}
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          {hero.boutons.map((b: any) => (
            <Button href={b.href} style={b.style} class="w-full sm:w-auto">{b.libelle}</Button>
          ))}
        </div>
        <p class="mt-8 inline-flex items-center gap-2 rounded-full bg-gris px-4 py-2 text-xs font-semibold text-gris-600">
          <span class="h-2 w-2 rounded-full bg-vert" aria-hidden="true"></span>
          {site.bandeauPilote}
        </p>
      </div>

      <div class="reveal">
        <Bracket data={hero.bracket} />
      </div>
    </div>

    <!-- Signature « arc de trajectoire » : une seule fois, en fil conducteur -->
    <TrajectoryArc class="h-16 w-full md:h-24" />
  </section>

  <!-- ============ LE CONSTAT ============ -->
  <Section bg="blanc">
    <div class="reveal grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <SectionHeader surtitre={constat.surtitre} titre={constat.titre} />
      <p class="text-base leading-relaxed text-gris-600 md:text-lg">{constat.texte}</p>
    </div>
  </Section>

  <!-- ============ TROIS PUBLICS ============ -->
  <Section bg="gris">
    <SectionHeader surtitre={publics.surtitre} titre={publics.titre} class="reveal" />
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {publics.cartes.map((c: any) => (
        <a
          href={c.lien.href}
          class="reveal group flex flex-col rounded-xl bg-blanc p-6 shadow-soft ring-1 ring-marine/5 transition-all duration-200 ease-out-soft hover:-translate-y-1 hover:shadow-card"
        >
          <p class="text-sm font-semibold uppercase tracking-wide text-orange">{c.surtitre}</p>
          <p class="mt-3 flex-1 text-base leading-relaxed text-marine">{c.texte}</p>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-marine group-hover:text-orange">
            {c.lien.libelle}
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
          </span>
        </a>
      ))}
    </div>
  </Section>

  <!-- ============ LE DÉROULÉ (numérotation justifiée) ============ -->
  <Section bg="blanc">
    <SectionHeader surtitre={deroule.surtitre} titre={deroule.titre} class="reveal" />
    <ol class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {deroule.etapes.map((e: any, i: number) => (
        <li class="reveal relative flex flex-col rounded-xl border border-gris-200 bg-blanc p-6">
          <span
            class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-marine text-lg font-bold text-blanc"
            aria-hidden="true"
          >
            {i + 1}
          </span>
          <h3 class="text-lg font-bold text-marine">{e.titre}</h3>
          <p class="mt-2 text-sm leading-relaxed text-gris-600">{e.texte}</p>
        </li>
      ))}
    </ol>
  </Section>

  <!-- ============ COMPLÉMENTARITÉ ============ -->
  <Section bg="marine" size="compact">
    <div class="reveal mx-auto max-w-3xl text-center">
      <h2 class="text-2xl font-bold text-blanc md:text-3xl">{complementarite.titre}</h2>
      <p class="mt-4 text-base leading-relaxed text-blanc/75 md:text-lg">{complementarite.texte}</p>
    </div>
  </Section>

  <!-- ============ PREUVE (emplacements à compléter) ============ -->
  <Section bg="gris">
    <SectionHeader surtitre={preuve.surtitre} titre={preuve.titre} class="reveal" />
    <div class="mt-12 grid gap-6 lg:grid-cols-[1.4fr_1fr]">
      <figure class="reveal flex flex-col gap-6 rounded-xl bg-blanc p-8 shadow-soft ring-1 ring-marine/5 sm:flex-row sm:items-center">
        <div class="h-24 w-24 shrink-0 overflow-hidden rounded-full border-2 border-dashed border-gris-200 bg-gris">
          <div class="flex h-full items-center justify-center px-2 text-center text-[0.6rem] font-semibold text-gris-600">
            {preuve.citation.role}
          </div>
        </div>
        <div>
          <blockquote class="text-lg font-semibold leading-relaxed text-marine">
            « {preuve.citation.texte} »
          </blockquote>
          <figcaption class="mt-3 text-sm text-gris-600">
            <span class="font-semibold text-marine">{preuve.citation.auteur}</span> · {preuve.citation.role}
          </figcaption>
        </div>
      </figure>

      <div class="reveal flex flex-col items-center justify-center rounded-xl bg-marine p-8 text-center text-blanc">
        <p class="text-4xl font-bold text-vert">{preuve.chiffre.valeur}{preuve.chiffre.unite}</p>
        <p class="mt-2 text-sm text-blanc/75">{preuve.chiffre.libelle}</p>
      </div>
    </div>
  </Section>

  <!-- ============ CTA FINAL ============ -->
  <Section bg="blanc">
    <h2 class="reveal text-center text-2xl font-bold text-marine md:text-3xl">{ctaFinal.titre}</h2>
    <div class="reveal mt-10 grid gap-6 md:grid-cols-2">
      {ctaFinal.colonnes.map((col: any) => (
        <div class="flex flex-col items-start gap-4 rounded-xl border border-gris-200 bg-gris p-8">
          <p class="text-sm font-semibold uppercase tracking-wide text-orange">{col.surtitre}</p>
          <p class="flex-1 text-base leading-relaxed text-marine">{col.texte}</p>
          <Button href={col.bouton.href} style={col.bouton.style}>{col.bouton.libelle}</Button>
        </div>
      ))}
    </div>
  </Section>
</Base>
