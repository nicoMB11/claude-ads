---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/Button.astro';
import DemoForm from '../components/DemoForm.astro';

const { meta, hero, avantApres, blocs, complementarite, tarifs, demo } = (
  await getEntry('pages', 'clubs')
)!.data as any;
---

<Base titre={meta.titre} description={meta.description} ogImage={meta.ogImage}>
  <!-- HERO -->
  <Section bg="marine" size="compact">
    <div class="reveal mx-auto max-w-3xl text-center">
      <h1 class="text-3xl font-bold text-blanc md:text-4xl">{hero.titre}</h1>
      <p class="mt-6 text-base leading-relaxed text-blanc/75 md:text-lg">{hero.sousTitre}</p>
      <div class="mt-8 flex justify-center">
        {hero.boutons.map((b: any) => (
          <Button href={b.href} style={b.style}>{b.libelle}</Button>
        ))}
      </div>
    </div>
  </Section>

  <!-- AVANT / APRÈS — composant le plus fragile en mobile -->
  <Section bg="blanc">
    <SectionHeader surtitre={avantApres.surtitre} titre={avantApres.titre} class="reveal" />
    <div class="reveal mt-10 overflow-hidden rounded-xl border border-gris-200">
      <table class="avant-apres w-full border-collapse text-left">
        <thead>
          <tr>
            <th scope="col" class="w-1/2 bg-gris px-5 py-4 text-sm font-semibold text-gris-600">
              {avantApres.colonneAvant}
            </th>
            <th scope="col" class="w-1/2 bg-marine px-5 py-4 text-sm font-semibold text-blanc">
              {avantApres.colonneApres}
            </th>
          </tr>
        </thead>
        <tbody>
          {avantApres.lignes.map((l: any) => (
            <tr class="border-t border-gris-200">
              <td data-label={avantApres.colonneAvant} class="px-5 py-4 align-top text-sm text-gris-600">
                {l.avant}
              </td>
              <td data-label={avantApres.colonneApres} class="bg-marine/[0.03] px-5 py-4 align-top text-sm font-semibold text-marine">
                <span class="mr-2 inline-block h-1.5 w-1.5 rounded-full bg-vert align-middle" aria-hidden="true"></span>
                {l.apres}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Section>

  <!-- CINQ BLOCS -->
  <Section bg="gris">
    <SectionHeader surtitre={blocs.surtitre} titre={blocs.titre} class="reveal" />
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {blocs.items.map((b: any, i: number) => (
        <div
          id={b.id}
          class:list={[
            'reveal flex scroll-mt-24 flex-col rounded-xl bg-blanc p-7 shadow-soft ring-1 ring-marine/5',
            i === 0 ? 'md:col-span-2' : '',
          ]}
        >
          <span class="mb-3 inline-flex w-fit items-center gap-1.5 rounded-full bg-marine/5 px-3 py-1 text-xs font-semibold text-marine">
            <span class="h-1.5 w-1.5 rounded-full bg-orange" aria-hidden="true"></span>
            {b.public}
          </span>
          <h3 class="text-lg font-bold text-marine md:text-xl">{b.titre}</h3>
          <p class="mt-3 text-base leading-relaxed text-gris-600">{b.texte}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- COMPLÉMENTARITÉ -->
  <Section bg="marine" size="compact">
    <div class="reveal mx-auto max-w-3xl text-center">
      <h2 class="text-2xl font-bold text-blanc md:text-3xl">{complementarite.titre}</h2>
      <p class="mt-4 text-base leading-relaxed text-blanc/75 md:text-lg">{complementarite.texte}</p>
    </div>
  </Section>

  <!-- TARIFS (emplacement structuré, grille ajoutable plus tard) -->
  <Section bg="blanc">
    <SectionHeader surtitre={tarifs.surtitre} titre={tarifs.titre} align="center" class="reveal" />
    <div class="reveal mx-auto mt-8 max-w-2xl">
      {tarifs.grille && tarifs.grille.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-3">
          {tarifs.grille.map((offre: any) => (
            <div class="rounded-xl border border-gris-200 p-6">
              <p class="text-sm font-semibold text-orange">{offre.nom}</p>
              <p class="mt-2 text-3xl font-bold text-marine">{offre.prix}</p>
              <p class="mt-2 text-sm text-gris-600">{offre.description}</p>
            </div>
          ))}
        </div>
      ) : (
        <div class="rounded-xl border border-gris-200 bg-gris p-8 text-center">
          <p class="text-base leading-relaxed text-gris-600">{tarifs.message}</p>
          {tarifs.offreMiseEnAvant && (
            <p class="mt-5 inline-flex items-center gap-2 rounded-lg bg-marine px-5 py-3 text-sm font-semibold text-blanc">
              <span class="h-2 w-2 rounded-full bg-vert" aria-hidden="true"></span>
              {tarifs.offreMiseEnAvant}
            </p>
          )}
        </div>
      )}
    </div>
  </Section>

  <!-- FORMULAIRE DE DÉMO -->
  <Section bg="gris" id="demo">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <SectionHeader surtitre={demo.surtitre} titre={demo.titre} intro={demo.texte} class="reveal" />
      <div class="reveal rounded-xl bg-blanc p-6 shadow-soft ring-1 ring-marine/5 sm:p-8">
        <DemoForm data={demo} />
      </div>
    </div>
  </Section>
</Base>

<style>
  /* Table avant/après responsive : cartes empilées sous 640 px (test 360 px). */
  @media (max-width: 639px) {
    .avant-apres thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .avant-apres,
    .avant-apres tbody,
    .avant-apres tr,
    .avant-apres td {
      display: block;
      width: 100%;
    }
    .avant-apres tr {
      border-top: 1px solid var(--c-gris-200);
    }
    .avant-apres tr:first-child {
      border-top: 0;
    }
    .avant-apres td {
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }
    .avant-apres td::before {
      content: attr(data-label);
      display: block;
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      color: var(--c-gris-600);
      margin-bottom: 0.15rem;
    }
    .avant-apres td:last-child {
      padding-bottom: 1rem;
    }
  }
</style>
