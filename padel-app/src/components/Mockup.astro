---
/**
 * Illustration produit stylisée (maquette d'écran mobile) dessinée en SVG, aux
 * couleurs de la charte. Sert de visuel provisoire pour les blocs joueurs.
 *
 * ⚠️ À REMPLACER par de vraies captures d'écran de l'application (WebP, dimensions
 * explicites) quand elles seront disponibles. Voir la checklist du README.
 *
 * Props :
 *   type : 'bracket' | 'historique' | 'carte' | 'gratuit'
 *   alt  : description accessible (vient du contenu)
 */
interface Props {
  type: 'bracket' | 'historique' | 'carte' | 'gratuit';
  alt: string;
  class?: string;
}
const { type, alt, class: className = '' } = Astro.props;
---

<div class={`relative ${className}`} role="img" aria-label={alt}>
  <div class="mx-auto w-full max-w-[280px]">
    <div class="relative overflow-hidden rounded-[2rem] border-[6px] border-marine bg-blanc shadow-card">
      <!-- Barre de statut -->
      <div class="flex items-center justify-between bg-marine px-5 py-2 text-[0.6rem] text-blanc/80">
        <span>9:41</span>
        <span class="font-semibold text-vert">Padel App</span>
      </div>

      <div class="min-h-[380px] bg-gris p-4">
        {
          type === 'bracket' && (
            <div class="space-y-3">
              <p class="text-xs font-semibold text-marine">Votre prochain match</p>
              <div class="rounded-lg border border-orange/40 bg-orange/5 p-3">
                <div class="flex items-center justify-between text-[0.7rem] font-semibold text-orange">
                  <span>Terrain 3</span>
                  <span>Dans 12 min</span>
                </div>
                <p class="mt-1 text-sm font-semibold text-marine">Vous · Costa</p>
                <p class="text-xs text-gris-600">contre Nadeau / Riva</p>
              </div>
              {[1, 2, 3].map((i) => (
                <div class="flex items-center justify-between rounded-lg bg-blanc p-3">
                  <span class="text-xs text-marine">Tour {i}</span>
                  <span class="text-[0.7rem] font-semibold text-vert-600">Terminé</span>
                </div>
              ))}
            </div>
          )
        }

        {
          type === 'historique' && (
            <div class="space-y-3">
              <div class="rounded-lg bg-marine p-4 text-blanc">
                <p class="text-[0.65rem] uppercase tracking-wide text-blanc/60">Bilan</p>
                <p class="mt-1 text-2xl font-bold">
                  38<span class="text-vert"> V</span> · 21<span class="text-orange"> D</span>
                </p>
              </div>
              {['Open de printemps', 'P250 du club', 'Tournoi jeunes'].map((t, i) => (
                <div class="flex items-center justify-between rounded-lg bg-blanc p-3">
                  <div>
                    <p class="text-xs font-semibold text-marine">{t}</p>
                    <p class="text-[0.65rem] text-gris-600">6-3 · 4-6 · 6-2</p>
                  </div>
                  <span class="h-2 w-2 rounded-full bg-vert" />
                </div>
              ))}
            </div>
          )
        }

        {
          type === 'carte' && (
            <div class="space-y-3">
              <div class="relative flex h-32 items-center justify-center rounded-lg border border-gris-200 bg-blanc">
                <svg viewBox="0 0 100 60" class="h-full w-full opacity-40">
                  <path d="M0 20 H100 M0 40 H100 M50 0 V60" stroke="#9AA6B2" stroke-width="0.5" fill="none" />
                </svg>
                <span class="absolute" aria-hidden="true">
                  <svg viewBox="0 0 24 32" class="h-7 w-7">
                    <path d="M12 0C6 0 1 5 1 11c0 8 11 21 11 21s11-13 11-21C23 5 18 0 12 0Z" fill="#FF6500" />
                    <circle cx="12" cy="11" r="4" fill="#fff" />
                  </svg>
                </span>
              </div>
              {['Padel Club Lyon · 3 km', 'Set & Match · 8 km'].map((t) => (
                <div class="flex items-center justify-between rounded-lg bg-blanc p-3">
                  <span class="text-xs font-semibold text-marine">{t}</span>
                  <span class="rounded-full bg-orange px-2 py-0.5 text-[0.6rem] font-semibold text-blanc">
                    S'inscrire
                  </span>
                </div>
              ))}
            </div>
          )
        }

        {
          type === 'gratuit' && (
            <div class="flex min-h-[340px] flex-col items-center justify-center gap-3 text-center">
              <span class="flex h-16 w-16 items-center justify-center rounded-full bg-vert/15">
                <svg viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="#7FAF00" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <p class="text-lg font-bold text-marine">Gratuit</p>
              <p class="px-6 text-xs text-gris-600">Aucune carte bancaire. Aucune limite de tournois.</p>
            </div>
          )
        }
      </div>
    </div>
  </div>
</div>
