---
/**
 * Logo Padel App — recréé en SVG dans l'esprit de la charte (concept « balle en
 * mouvement ») : balle verte + trajectoire marine + repère orange, mot-symbole
 * « PADEL » marine et « APP » orange.
 *
 * ⚠️ La charte prévoit un redessin vectoriel définitif du logo (étape 3 du pack
 * de livrables). Quand ce fichier officiel sera fourni, remplacez ce composant
 * ou le SVG /public/logo-padel-app.svg. Voir la checklist du README.
 *
 * Props :
 *   variant : 'full' (symbole + nom) | 'mark' (symbole seul)
 *   class   : classes utilitaires additionnelles
 */
interface Props {
  variant?: 'full' | 'mark';
  class?: string;
}
const { variant = 'full', class: className = '' } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg
    class="h-8 w-8 shrink-0"
    viewBox="0 0 72 72"
    role="img"
    aria-hidden={variant === 'full' ? 'true' : 'false'}
    aria-label={variant === 'mark' ? 'Padel App' : undefined}
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- Balle de padel (vert padel) -->
    <circle cx="30" cy="36" r="20" fill="#9ED900" />
    <!-- Coutures de la balle -->
    <path
      d="M16 22 C 26 30 26 42 18 53"
      fill="none"
      stroke="#FFFFFF"
      stroke-width="2.5"
      stroke-linecap="round"
    />
    <path
      d="M44 22 C 34 30 34 42 42 53"
      fill="none"
      stroke="#FFFFFF"
      stroke-width="2.5"
      stroke-linecap="round"
    />
    <!-- Trajectoire (bleu marine) qui balaie sous la balle et remonte à droite -->
    <path
      d="M6 46 C 16 63 44 64 57 46 C 62 39 62 31 58 25"
      fill="none"
      stroke="#061B3A"
      stroke-width="5.5"
      stroke-linecap="round"
    />
    <!-- Repère de localisation (orange) au bout de la trajectoire -->
    <path
      d="M56 10 c -6 0 -10.5 4.6 -10.5 10.4 c 0 7 10.5 16.6 10.5 16.6 c 0 0 10.5 -9.6 10.5 -16.6 C 66.5 14.6 62 10 56 10 Z"
      fill="#FF6500"
    />
    <circle cx="56" cy="20.4" r="3.6" fill="#FFFFFF" />
  </svg>

  {
    variant === 'full' && (
      <span class="font-bold leading-none tracking-tight text-[1.35rem]">
        <span class="text-marine">PADEL</span
        ><span class="text-orange"> APP</span>
      </span>
    )
  }
</span>
