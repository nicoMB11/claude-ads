---
import { getEntry } from 'astro:content';
import Logo from './Logo.astro';

const site = (await getEntry('global', 'site'))!.data;
const footer = site.footer;
---

<footer class="bg-marine text-blanc">
  <div class="container-x py-14 md:py-16">
    <div class="grid gap-10 md:grid-cols-[1.4fr_repeat(3,1fr)]">
      <div class="max-w-xs">
        <div class="mb-4">
          <Logo variant="mark" class="text-blanc" />
          <span class="ml-2.5 align-middle text-[1.35rem] font-bold leading-none tracking-tight">
            <span class="text-blanc">PADEL</span><span class="text-orange"> APP</span>
          </span>
        </div>
        <p class="text-sm leading-relaxed text-blanc/70">{footer.tagline}</p>
      </div>

      {
        footer.colonnes?.map((col) => (
          <div>
            <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-blanc/50">
              {col.titre}
            </h2>
            <ul class="flex flex-col gap-2">
              {col.liens.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="text-sm text-blanc/80 underline-offset-4 hover:text-orange hover:underline"
                  >
                    {l.libelle}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {
      footer.mentionSepare && (
        <p class="mt-12 border-t border-blanc/10 pt-6 text-xs leading-relaxed text-blanc/50">
          {footer.mentionSepare}
        </p>
      )
    }

    <div class="mt-6 flex flex-col items-start justify-between gap-3 text-xs text-blanc/50 sm:flex-row sm:items-center">
      <p>{footer.copyright}</p>
      {
        footer.legal && (
          <ul class="flex flex-wrap gap-4">
            {footer.legal.map((l) => (
              <li>
                <a href={l.href} class="underline-offset-4 hover:text-blanc hover:underline">
                  {l.libelle}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</footer>
