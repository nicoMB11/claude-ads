---
import { getEntry } from 'astro:content';
import Logo from './Logo.astro';
import Button from './Button.astro';

const site = (await getEntry('global', 'site'))!.data;
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.split('#')[0]);
---

<header class="sticky top-0 z-50 border-b border-gris-200 bg-blanc/95 backdrop-blur supports-[backdrop-filter]:bg-blanc/80">
  <nav class="container-x flex h-[var(--header-h)] items-center justify-between gap-4" aria-label="Navigation principale">
    <a href="/" class="rounded-md" aria-label={`${site.nom} — accueil`}>
      <Logo variant="full" />
    </a>

    <!-- Navigation bureau -->
    <ul class="hidden items-center gap-1 lg:flex">
      {
        site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'rounded-md px-3 py-2 text-sm font-semibold transition-colors',
                isActive(item.href) ? 'text-orange' : 'text-marine hover:text-orange',
              ]}
            >
              {item.libelle}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden lg:block">
      {site.navCta && <Button href={site.navCta.href} style="principal">{site.navCta.libelle}</Button>}
    </div>

    <!-- Bouton menu mobile -->
    <button
      type="button"
      id="menu-toggle"
      class="inline-flex items-center justify-center rounded-md p-2 text-marine lg:hidden"
      aria-controls="menu-mobile"
      aria-expanded="false"
      aria-label="Ouvrir le menu"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </nav>

  <!-- Panneau mobile -->
  <div id="menu-mobile" hidden class="border-t border-gris-200 bg-blanc lg:hidden">
    <ul class="container-x flex flex-col gap-1 py-4">
      {
        site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'block rounded-md px-3 py-3 text-base font-semibold',
                isActive(item.href) ? 'text-orange' : 'text-marine',
              ]}
            >
              {item.libelle}
            </a>
          </li>
        ))
      }
      {
        site.navCta && (
          <li class="pt-2">
            <Button href={site.navCta.href} style="principal" class="w-full">
              {site.navCta.libelle}
            </Button>
          </li>
        )
      }
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const panel = document.getElementById('menu-mobile');
  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.setAttribute('aria-label', open ? 'Ouvrir le menu' : 'Fermer le menu');
      panel.hidden = open;
    });
    // Referme le menu après un clic sur un lien.
    panel.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Ouvrir le menu');
        panel.hidden = true;
      }),
    );
  }
</script>
